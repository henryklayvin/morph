<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.henryklayvin.morph</groupId>
        <artifactId>morph-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>morph-cli</artifactId>
    <name>Morph :: CLI</name>
    <description>The `morph` executable.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.henryklayvin.morph</groupId>
            <artifactId>morph-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.henryklayvin.morph</groupId>
            <artifactId>morph-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.henryklayvin.morph</groupId>
            <artifactId>morph-application</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.henryklayvin.morph</groupId>
            <artifactId>morph-local-web</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <mainClass>io.github.henryklayvin.morph.cli.Main</mainClass>
                        </manifest>
                        <manifestEntries>
                            <!-- JEP 472: lets JDK 24+ load the WebP encoder without warnings. Ignored by JDK 21. -->
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>distribution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <finalName>morph-${project.version}</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                            <attach>false</attach>
                            <descriptors>
                                <descriptor>src/assembly/distribution.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
