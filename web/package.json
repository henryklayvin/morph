{
  "name": "morph-web",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Morph user interface, shared by Morph Local and (from phase 3) the public Web build.",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:local": "tsc --noEmit && vite build --mode morph-local",
    "e2e": "node e2e/local.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
