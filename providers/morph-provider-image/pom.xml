<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.morph</groupId>
        <artifactId>morph-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>morph-provider-image</artifactId>
    <name>Morph :: Provider :: Image</name>
    <description>PNG, JPEG and WebP conversions.</description>

    <dependencies>
        <dependency>
            <groupId>dev.morph</groupId>
            <artifactId>morph-contracts</artifactId>
        </dependency>
        <!-- Pure Java JPEG reader: CMYK, broken and unusual files that the JDK reader rejects. -->
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-jpeg</artifactId>
        </dependency>
        <!-- Pure Java WebP reader, used to verify what the native encoder wrote. -->
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-webp</artifactId>
        </dependency>
        <!-- libwebp encoder (JNI). Only ever fed with pixels Morph decoded, never with untrusted bytes. -->
        <dependency>
            <groupId>dev.matrixlab.webp4j</groupId>
            <artifactId>webp4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.morph</groupId>
            <artifactId>morph-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
