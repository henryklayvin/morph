<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.morph</groupId>
        <artifactId>morph-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>morph-application</artifactId>
    <name>Morph :: Application</name>
    <description>Composition root: discovers providers and assembles the engine.</description>

    <dependencies>
        <dependency>
            <groupId>dev.morph</groupId>
            <artifactId>morph-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.morph</groupId>
            <artifactId>morph-engine</artifactId>
        </dependency>
        <!-- Providers are runtime-only: nothing above this module may reference their classes. -->
        <dependency>
            <groupId>dev.morph</groupId>
            <artifactId>morph-provider-image</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>dev.morph</groupId>
            <artifactId>morph-provider-pdf</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
